// CSEC-ASTU Bootcamp Management System (BMS) - Prisma Schema v2.0
// Free Open-Source Architecture (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  DIVISION_ADMIN
  INSTRUCTOR
  STUDENT
  GUEST
}

enum ScopeType {
  GLOBAL
  DIVISION
  BOOTCAMP
}

enum EnrollmentStatus {
  APPLICANT
  APPLICANT_REJECTED
  STUDENT
  DROPPED
  INDUCTED
  NOT_INDUCTED
}

enum SessionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum TaskType {
  INDIVIDUAL
  GROUP_MILESTONE
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

enum SubmissionType {
  FILE
  GITHUB_LINK
  BOTH
}

enum QualitativeFlag {
  EXCELLENT
  SATISFACTORY
  NEEDS_IMPROVEMENT
}

enum BootcampStatus {
  DRAFT
  OPEN
  SCREENING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  TELEGRAM
}

enum InductionDecisionValue {
  INDUCTED
  NOT_INDUCTED
}

// ─── Users & Roles ────────────────────────────────────────────────────────────

model User {
  id                     String    @id @default(uuid())
  fullName               String
  email                  String    @unique
  passwordHash           String
  universityId           String?   @unique
  department             String?
  telegramUsername       String?
  telegramChatId         String?
  isEmailVerified        Boolean   @default(false)
  refreshTokenHash       String?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  roleAssignments        UserRoleAssignment[]
  enrollments            Enrollment[]
  submissions            Submission[]
  attendanceRecords      AttendanceRecord[]
  sessionFeedbacks       SessionFeedback[]
  peerReviewsGiven       PeerReview[]          @relation("ReviewerRelation")
  peerReviewsReceived    PeerReview[]          @relation("RevieweeRelation")
  notifications          Notification[]
  groupMemberships       GroupMember[]
  inductionDecisions     InductionDecision[]   @relation("DecidedByRelation")
  auditLogs              AuditLog[]
  proposedSessions       Session[]             @relation("InstructorRelation")
}

model UserRoleAssignment {
  id        String    @id @default(uuid())
  userId    String
  role      Role
  scopeType ScopeType
  scopeId   String?   // divisionId or bootcampId; null when scopeType = GLOBAL

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeType, scopeId])
  @@index([userId])
  @@index([scopeId])
}

// ─── Divisions ────────────────────────────────────────────────────────────────

model Division {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  bootcamps   Bootcamp[]
}

// ─── Bootcamps ────────────────────────────────────────────────────────────────

model Bootcamp {
  id                   String         @id @default(uuid())
  divisionId           String
  title                String
  description          String?
  status               BootcampStatus @default(DRAFT)
  applicationOpenAt    DateTime?
  applicationCloseAt   DateTime?
  startDate            DateTime?
  endDate              DateTime?
  maxApplicants        Int?

  // Scoring weights (must sum to 100)
  attendanceWeight     Int            @default(20)
  individualTaskWeight Int            @default(40)
  groupMilestoneWeight Int            @default(30)
  peerReviewWeight     Int            @default(10)

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  division             Division       @relation(fields: [divisionId], references: [id])
  enrollments          Enrollment[]
  sessions             Session[]
  tasks                Task[]
  groups               Group[]
  resources            Resource[]

  @@index([divisionId])
  @@index([status])
}

// ─── Enrollments & Applications ───────────────────────────────────────────────

model Enrollment {
  id                String             @id @default(uuid())
  userId            String
  bootcampId        String
  status            EnrollmentStatus   @default(APPLICANT)
  appliedAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Application form fields
  motivation        String?
  experience        String?
  portfolioUrl      String?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bootcamp          Bootcamp           @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  inductionDecision InductionDecision?

  @@unique([userId, bootcampId])
  @@index([bootcampId, status])
}

// ─── Sessions ─────────────────────────────────────────────────────────────────

model Session {
  id            String        @id @default(uuid())
  bootcampId    String
  instructorId  String
  title         String
  description   String?
  location      String?       // physical room or URL
  startTime     DateTime
  endTime       DateTime
  status        SessionStatus @default(PENDING)
  rejectionNote String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bootcamp          Bootcamp           @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  instructor        User               @relation("InstructorRelation", fields: [instructorId], references: [id])
  attendanceCode    AttendanceCode?
  attendanceRecords AttendanceRecord[]
  sessionFeedbacks  SessionFeedback[]
  resources         Resource[]

  @@index([bootcampId])
  @@index([startTime, endTime]) // global overlap check
}

model AttendanceCode {
  id            String   @id @default(uuid())
  sessionId     String   @unique
  code          String   @unique
  windowMinutes Int      @default(30)
  openedAt      DateTime @default(now())
  expiresAt     DateTime

  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  sessionId    String
  userId       String
  status       AttendanceStatus
  submittedAt  DateTime?
  overrideNote String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  session      Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

// ─── Tasks & Submissions ──────────────────────────────────────────────────────

model Task {
  id                  String         @id @default(uuid())
  bootcampId          String
  type                TaskType
  title               String
  description         String?
  instructions        String?
  submissionType      SubmissionType
  deadline            DateTime
  maxScore            Float
  allowLateSubmission Boolean        @default(false)
  latePenaltyPercent  Float?
  allowResubmission   Boolean        @default(true)
  peerReviewRequired  Boolean        @default(false)
  milestoneNumber     Int?           // GROUP_MILESTONE only; ordering within capstone
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  bootcamp            Bootcamp       @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  submissions         Submission[]

  @@index([bootcampId, type])
}

model Submission {
  id          String           @id @default(uuid())
  taskId      String
  userId      String?          // null for group submissions
  groupId     String?          // null for individual submissions
  version     Int              @default(1)
  fileUrl     String?
  githubUrl   String?
  status      SubmissionStatus @default(SUBMITTED)
  score       Float?
  feedback    String?
  qualFlag    QualitativeFlag?
  submittedAt DateTime         @default(now())
  gradedAt    DateTime?
  gradedBy    String?          // userId of grader

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id])
  group       Group?           @relation(fields: [groupId], references: [id])
  peerReviews PeerReview[]

  @@index([taskId])
  @@index([userId])
  @@index([groupId])
}

// ─── Groups ───────────────────────────────────────────────────────────────────

model Group {
  id          String        @id @default(uuid())
  bootcampId  String
  name        String
  createdAt   DateTime      @default(now())

  bootcamp    Bootcamp      @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  submissions Submission[]

  @@index([bootcampId])
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  isLeader Boolean  @default(false)
  joinedAt DateTime @default(now())

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// ─── Peer Reviews ─────────────────────────────────────────────────────────────

model PeerReview {
  id           String     @id @default(uuid())
  submissionId String
  reviewerId   String
  revieweeId   String
  rating       Int        // 1–5
  comment      String?
  submittedAt  DateTime   @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer     User       @relation("ReviewerRelation", fields: [reviewerId], references: [id])
  reviewee     User       @relation("RevieweeRelation", fields: [revieweeId], references: [id])

  @@unique([submissionId, reviewerId, revieweeId])
}

// ─── Session Feedback ─────────────────────────────────────────────────────────

model SessionFeedback {
  id          String   @id @default(uuid())
  sessionId   String
  userId      String
  rating      Int      // 1–5
  comment     String?
  submittedAt DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

// ─── Induction ────────────────────────────────────────────────────────────────

model InductionDecision {
  id                      String                 @id @default(uuid())
  enrollmentId            String                 @unique
  decision                InductionDecisionValue
  computedScoreAtDecision Float
  overrideNote            String?
  decidedById             String
  decidedAt               DateTime               @default(now())

  enrollment              Enrollment             @relation(fields: [enrollmentId], references: [id])
  decidedBy               User                   @relation("DecidedByRelation", fields: [decidedById], references: [id])
}

// ─── Resources ────────────────────────────────────────────────────────────────

model Resource {
  id            String    @id @default(uuid())
  bootcampId    String?
  sessionId     String?
  title         String
  description   String?
  fileUrl       String?
  externalUrl   String?
  mimeType      String?
  downloadCount Int       @default(0)
  uploadedById  String
  createdAt     DateTime  @default(now())

  bootcamp      Bootcamp? @relation(fields: [bootcampId], references: [id])
  session       Session?  @relation(fields: [sessionId], references: [id])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel
  eventType String              // e.g. "SESSION_APPROVED", "TASK_GRADED"
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  sentAt    DateTime            @default(now())

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model NotificationPreference {
  id          String @id @default(uuid())
  userId      String @unique
  preferences Json   @default("{}")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String   // e.g. "INDUCTION_OVERRIDE", "ATTENDANCE_OVERRIDE"
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User     @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
}

